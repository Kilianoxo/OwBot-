# ────────────────────────────────────────────
# Copie ce fichier en .env et remplis les valeurs
# ────────────────────────────────────────────

# OBLIGATOIRE — Token de ton bot Discord
# Crée ton bot sur https://discord.com/developers/applications
DISCORD_TOKEN=ton_token_discord_ici

# OPTIONNEL — API Claude (Anthropic) pour les raps et blagues IA
# Sans cette clé, le bot utilise des templates pré-écrits
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OPTIONNEL — API OpenAI pour la transcription vocale (Whisper)
# Alternative : installer faster-whisper pour du STT 100% local
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
